# FieldOps — variáveis de ambiente do ambiente local (docs/arquitetura.md §11.10, §11.12)
#
# Copie para `.env` (nunca commite o `.env` real — RNF-010 / RN-007) e ajuste
# o que for necessário. Este arquivo alimenta o docker-compose.yml na raiz
# do repositório; cada aplicação (api/, mobile/, web/) também lê estas
# mesmas variáveis via seu próprio mecanismo de configuração local
# (application-local.yml no Spring Boot, app.config/.env no Expo,
# environment.ts no Angular) — os nomes abaixo são a referência única para
# não haver divergência entre os três.

# ---------------------------------------------------------------------------
# Banco de dados (PostgreSQL — docs/modelo-de-dados.md §10.1)
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fieldops
DB_USER=fieldops
DB_PASSWORD=fieldops
DB_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}

# ---------------------------------------------------------------------------
# API — autenticação (docs/arquitetura.md §11.10, docs/api-rest.md §12.4)
# ---------------------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# Gere um valor próprio por ambiente, nunca reutilize o de outro ambiente:
#   openssl rand -base64 48
JWT_SECRET=troque-este-valor-antes-de-subir-qualquer-ambiente-compartilhado
# 900s = 15 min, mesmo valor do exemplo de resposta de login em api-rest.md §12.4.
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=900
JWT_REFRESH_TOKEN_EXPIRATION_SECONDS=604800

# Origens autorizadas a chamar a API (interface administrativa em dev).
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ---------------------------------------------------------------------------
# Armazenamento de evidências — compatível com S3 (docs/arquitetura.md §11.8)
# Em produção, aponte para um provedor de objetos gerenciado e troque as
# credenciais; os nomes de variável permanecem os mesmos.
# ---------------------------------------------------------------------------
EVIDENCE_STORAGE_ENDPOINT=http://localhost:9000
EVIDENCE_STORAGE_CONSOLE_PORT=9001
EVIDENCE_STORAGE_PORT=9000
EVIDENCE_STORAGE_BUCKET=fieldops-evidence
EVIDENCE_STORAGE_REGION=us-east-1
EVIDENCE_STORAGE_ACCESS_KEY=fieldops
EVIDENCE_STORAGE_SECRET_KEY=fieldops123
# RN-046 — limite de tamanho de upload de evidência, em bytes (10 MB).
EVIDENCE_MAX_UPLOAD_SIZE_BYTES=10485760

# ---------------------------------------------------------------------------
# Ferramentas locais opcionais (docker compose --profile tools up -d)
# ---------------------------------------------------------------------------
ADMINER_PORT=8081

# ---------------------------------------------------------------------------
# Aplicativo mobile (Expo) — variáveis públicas, sem segredos (RN-007)
# ---------------------------------------------------------------------------
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Modo mock: o app responde a partir de dados fictícios em memória, sem rede.
# Ligado por padrão enquanto a API não sobe; use false para falar com o backend.
EXPO_PUBLIC_API_MOCK=true
# Latência simulada do modo mock, em ms (deixa os estados de carregamento visíveis).
EXPO_PUBLIC_API_MOCK_LATENCY_MS=450
# Tempo limite de cada requisição HTTP, em ms.
EXPO_PUBLIC_API_TIMEOUT_MS=20000

# ---------------------------------------------------------------------------
# Interface administrativa (Angular) — refletir em src/environments/environment.ts
# ---------------------------------------------------------------------------
WEB_API_BASE_URL=http://localhost:8080/api/v1

# ---------------------------------------------------------------------------
# Usuários de demonstração criados por db/seed.sql (docs/criterios-de-avaliacao.md §19.8)
# Senha para todos: FieldOps@2026 — válida apenas em ambiente local/integração.
# ---------------------------------------------------------------------------
DEMO_ADMIN_EMAIL=admin@fieldops.local
DEMO_SUPERVISOR_EMAIL=supervisor@fieldops.local
DEMO_TECHNICIAN_EMAIL=tecnico@fieldops.local
DEMO_PASSWORD=FieldOps@2026
