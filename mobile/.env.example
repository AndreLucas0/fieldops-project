# Variáveis do aplicativo Expo.
#
# Copie para `.env` (o `.env` real não vai para o repositório — RNF-010).
# Só variáveis prefixadas com EXPO_PUBLIC_ chegam ao bundle, e por isso
# nenhuma delas pode conter segredo (RN-007).
#
# Os nomes espelham o `.env.example` da raiz do projeto, que é a referência
# única entre API, web e mobile.

EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Em dispositivo físico, `localhost` aponta para o próprio aparelho.
# Use o IP da máquina que roda a API na mesma rede, por exemplo:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.0.10:8080/api/v1
