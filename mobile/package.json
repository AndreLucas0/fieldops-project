{
  "name": "fieldops-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@expo-google-fonts/archivo": "^0.4.2",
    "@expo-google-fonts/barlow": "^0.4.1",
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "~57.0.13",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.10",
    "expo-crypto": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-image-picker": "~57.0.10",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-location": "~57.0.10",
    "expo-router": "~57.0.13",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.6",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.4",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "^@babel/runtime/(.*)$": "<rootDir>/node_modules/@babel/runtime/$1",
      "^@fieldops/shared$": "<rootDir>/../shared/src/index.ts",
      "^@fieldops/shared/(.*)$": "<rootDir>/../shared/src/$1",
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "app/**/*.tsx"
    ],
    "testTimeout": 20000
  }
}
